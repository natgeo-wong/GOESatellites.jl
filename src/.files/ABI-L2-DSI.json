{
  "ID": "ABI-L2-DSI",
  "name": "Advanced Baseline Imager Level 2 - Derived Stability Indices",
  "aws": true,
  "description": "Computes five thermodynamic stability indices\u2014CAPE, K-Index, Lifted Index, Showalter Index, and Total Totals\u2014from retrieved temperature and moisture profiles. These indices are widely used to assess convective potential and severe weather risk.",
  "16": {
    "sector": {
      "C": {"start": "2019-12-06", "end": "2025-04-07"},
      "F": {"start": "2019-12-06", "end": "2025-04-07"},
      "M": {"start": "2019-12-06", "end": "2025-04-07"}
    },
    "variables": {
